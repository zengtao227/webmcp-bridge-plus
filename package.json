{
  "name": "webmcp-bridge-plus",
  "version": "0.1.0",
  "private": true,
  "description": "WebMCP Bridge Plus: multi-host orchestration built on the stable Native WebMCP execution-host foundation.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test",
    "lint": "node scripts/check-js.mjs",
    "build:native": "node scripts/build-native.mjs",
    "build:menubar": "./scripts/build-menubar.sh",
    "test:menubar": "./scripts/test-menubar.sh",
    "validate:fresh-user": "node scripts/fresh-user-acceptance.mjs",
    "native:configure": "node native/deploy/configure-workspace.js",
    "native:image": "node native/deploy/build-image.js",
    "native:container": "node native/deploy/container-controller.js",
    "native:deploy-host": "node native/deploy/deploy-host-boundary.js",
    "native:canary": "node native/deploy/canary.js",
    "webmcp": "node native/deploy/installer.js",
    "build": "npm run build:native",
    "check": "npm run lint && npm test && npm run build",
    "devspace:inspect": "node scripts/devspace-efficiency.mjs inspect",
    "devspace:validate": "node scripts/devspace-efficiency.mjs validate"
  }
}
